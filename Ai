function m(n){return (n<0?'-':'')+'$'+Math.abs(n).toLocaleString(undefined,{maximumFractionDigits:2})}
function cls(n){return n>=0?'g':'r'}
async function go(){try{
 var r=await fetch('/api/state'+q);if(!r.ok)throw new Error(r.status);var s=await r.json();
 document.getElementById('m').textContent=s.cfg.tf+'m candles · risk '+s.cfg.risk+'% · threshold '+s.cfg.thr+' · refreshed '+new Date().toLocaleTimeString();
