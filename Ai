  var tr=a.trades.map(function(t){return '<div class="row"><span>'+(t.side===1?'L':'S')+' '+f(t.entry)+'→'+f(t.exit)+' <span class="d">'+t.why+'</span></span><span class="'+cls(t.net)+'">'+m(t.net)+'</span></div>'}).join('');
  return '<div class="p"><div class="row"><b>'+a.pair+' '+(a.px?f(a.px):'—')+'</b><span class="b '+side+'">'+side+(a.sig?' '+a.sig.s.toFixed(2):'')+'</span></div>'
